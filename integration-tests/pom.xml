<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>se.swedenconnect.keycloak</groupId>
        <artifactId>keycloak-plugins-parent</artifactId>
        <version>0.7.0-SNAPSHOT</version>
    </parent>

    <artifactId>integration-tests</artifactId>
    <packaging>jar</packaging>

    <name>Integration Tests</name>
    <description>Boots a real Keycloak with every plugin jar mounted and asserts the providers register</description>
    <url>https://github.com/swedenconnect/keycloak-plugins</url>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <providers.dir>${project.build.directory}/providers</providers.dir>
        <!--
          This module has no src/main/java: its jar carries nothing but Maven metadata. Deploying it
          would publish an empty artifact to whichever repository the build targets, so it is never
          deployed. It is still built and installed, because the reactor runs its tests.
        -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!--
          The plugin modules are declared as dependencies purely to force reactor ordering:
          maven-dependency-plugin does not create it on its own, and the copy below needs the
          jars to have been built already.
        -->
        <dependency>
            <groupId>se.swedenconnect.keycloak</groupId>
            <artifactId>sweden-connect-provider</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>se.swedenconnect.keycloak</groupId>
            <artifactId>pkcs11</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>se.swedenconnect.keycloak</groupId>
            <artifactId>oidf</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>se.swedenconnect.keycloak</groupId>
            <artifactId>keycloak-login-customizer</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.github.dasniko</groupId>
            <artifactId>testcontainers-keycloak</artifactId>
            <version>3.4.0</version>
            <scope>test</scope>
        </dependency>
        <!--
          dasniko 3.4.0 pins testcontainers 1.19.8 internally; override it explicitly.
          1.21.4 or later is required: earlier releases negotiate Docker API 1.32, which Docker
          Engine 29 rejects ("client version 1.32 is too old, minimum supported API version 1.40").
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <version>1.21.4</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-engine</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Style-check: this module has no src/main/java to check. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>

            <!-- Stage exactly the jars that get deployed to /opt/keycloak/providers. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>stage-provider-jars</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${providers.dir}</outputDirectory>
                            <overWriteReleases>true</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>se.swedenconnect.keycloak</groupId>
                                    <artifactId>sweden-connect-provider</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>jar-with-dependencies</classifier>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>se.swedenconnect.keycloak</groupId>
                                    <artifactId>pkcs11</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>jar-with-dependencies</classifier>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>se.swedenconnect.keycloak</groupId>
                                    <artifactId>oidf</artifactId>
                                    <version>${project.version}</version>
                                    <classifier>jar-with-dependencies</classifier>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>se.swedenconnect.keycloak</groupId>
                                    <artifactId>keycloak-login-customizer</artifactId>
                                    <version>${project.version}</version>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              Failsafe lives here and not in the root pom on purpose: the root applies to every
              module, and sweden-connect-provider's manual browser harness would then be launched
              by `mvn verify`.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <version>3.5.2</version>
                <executions>
                    <execution>
                        <id>integration-test</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <systemPropertyVariables>
                        <keycloak.version>${keycloak.version}</keycloak.version>
                        <providers.dir>${providers.dir}</providers.dir>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
